3','Niños Héroes', 5], ['Niños Héroes','Hospital General', 5], ['Hospital General','Centro Médico', 5], ['Centro Médico','Etiopía', 5],","  ['Etiopía','Eugenia', 5], ['Eugenia','División del Norte', 5], ['División del Norte','Zapata', 5], ['Zapata','Coyoacán', 5],","  ['Coyoacán','Viveros', 5], ['Viveros','Miguel Ángel de Quevedo', 5], ['Miguel Ángel de Quevedo','Copilco', 5], ['Copilco','Universidad', 5],","  ['Politécnico','Instituto del Petróleo', 5], ['Instituto del Petróleo','Autobuses del Norte', 5], ['Autobuses del Norte','La Raza L5', 5],","  ['La Raza L5','Misterios', 5], ['Misterios','Valle Gómez', 5], ['Valle Gómez','Consulado', 5], ['Consulado','Eduardo Molina', 5],","  ['Eduardo Molina','Aragón', 5], ['Aragón','Oceanía', 5], ['Oceanía','Terminal Aérea', 5], ['Terminal Aérea','Hangares', 5],","  ['Hangares','Pantitlán L5', 5], ['Buenavista','Guerrero LB', 5], ['Guerrero LB','Garibaldi', 5], ['Garibaldi','Lagunilla', 5],","  ['Lagunilla','Tepito', 5], ['Tepito','Morelos', 5], ['Morelos','San Lázaro LB', 5], ['San Lázaro LB','Candelaria LB', 5],","  ['Candelaria LB','Merced', 5], ['Merced','Candelaria LB2', 5], ['Candelaria LB2','San Lázaro LB2', 5], ['Balderas','Balderas L3', 12],","  ['Hidalgo','Hidalgo L3', 12], ['Pino Suárez','Pino Suárez L2', 12], ['San Antonio Abad','San Antonio Abad L2', 12],","  ['Candelaria','Candelaria LB', 12], ['Candelaria','Candelaria LB2', 12], ['San Lázaro','San Lázaro LB', 12], ['San Lázaro','San Lázaro LB2', 12],","  ['Pantitlán','Pantitlán L5', 12], ['La Raza','La Raza L5', 12], ['Guerrero','Guerrero LB', 12],","];","","const LEVELS = [","  { day: 'LUNES', start: 'Tacuba', goal: 'Pantitlán', startDesc: '🏠 Tu casa en Tacuba. Llega a la escuela en Pantitlán.', goalDesc: '🎉 ¡Llegaste a la escuela!', moneyStart: 150, staminaMax: 100, blocked: [] },","  { day: 'MARTES', start: 'Indios Verdes', goal: 'Universidad', startDesc: '🏠 Tu casa en Indios Verdes. Llega a la UNAM.', goalDesc: ' ¡Llegaste a la UNAM!', moneyStart: 180, staminaMax: 110, blocked: ['Tlatelolco'] },","  { day: 'MIÉRCOLES', start: 'Cuatro Caminos', goal: 'Tasqueña', startDesc: '🏠 Tu casa en Cuatro Caminos. Llega al trabajo en Tasqueña.', goalDesc: '💼 ¡Llegaste al trabajo!', moneyStart: 200, staminaMax: 120, blocked: ['Guerrero', 'Guerrero LB'] },","  { day: 'JUEVES', start: 'Politécnico', goal: 'Zapata', startDesc: '🏠 Tu casa en el Politécnico. Llega a una junta en Zapata.', goalDesc: '💼 ¡Llegaste a la junta!', moneyStart: 220, staminaMax: 100, blocked: ['La Raza', 'La Raza L5', 'Autobuses del Norte'] },","  { day: 'VIERNES', start: 'Observatorio', goal: 'Pantitlán', startDesc: ' Tu casa en Observatorio. Llega a una fiesta en Pantitlán.', goalDesc: ' ¡Llegaste a la fiesta!', moneyStart: 250, staminaMax: 90, blocked: ['Isabel la Católica', 'Pino Suárez', 'Pino Suárez L2', 'Candelaria', 'Candelaria LB', 'Candelaria LB2'] }","];","","const DAY_START_MINUTES = 7 * 60; const DAY_END_MINUTES = 20 * 60; const TOTAL_DAY_MINUTES = DAY_END_MINUTES - DAY_START_MINUTES;","let state = { level: 0, currentStation: null, selectedStation: null, stamina: 100, staminaMax: 100, money: 150, dayMinutes: DAY_START_MINUTES, paused: false, gameOver: false, steps: 0, robbed: 0, luck: 0.15, visitedStations: new Set(), blockedStations: new Set(), newsLog: [], unreadNews: 0, newsTimer: null, monsterDiscount: false, dangerBoost: 0, timeModifiers: {}, dangerStations: new Set(), cameraX: 0, cameraY: 0, hoveredStation: null, isDragging: false, dragStartX: 0, dragStartY: 0, dragCameraX: 0, dragCameraY: 0 };","let canvas, ctx, animationFrame;","","function init() {","  canvas = document.getElementById('iso-canvas'); ctx = canvas.getContext('2d'); resizeCanvas();","  window.addEventListener('resize', resizeCanvas); canvas.addEventListener('click', handleCanvasClick);","  canvas.addEventListener('mousemove', handleCanvasMove); canvas.addEventListener('mousedown', handleDragStart);","  canvas.addEventListener('mouseup', handleDragEnd); canvas.addEventListener('mouseleave', handleDragEnd);","  canvas.addEventListener('wheel', handleWheel, { passive: false });","  canvas.addEventListener('touchstart', handleTouchStart, { passive: false });","  canvas.addEventListener('touchmove', handleTouchMove, { passive: false });","  canvas.addEventListener('touchend', handleTouchEnd); startRenderLoop();","}","function resizeCanvas() { canvas.width = canvas.parentElement.clientWidth; canvas.height = canvas.parentElement.clientHeight; }","function startRenderLoop() { function render() { if (state.currentStation) renderIsoMap(); animationFrame = requestAnimationFrame(render); } render(); }","function changeZoom(delta) { ZOOM = Math.max(0.4, Math.min(2.5, ZOOM + delta)); document.getElementById('zoom-level').textContent = Math.round(ZOOM * 100) + '%'; }","function handleWheel(e) { e.preventDefault(); changeZoom(e.deltaY > 0 ? -0.1 : 0.1); }","function handleDragStart(e) { state.isDragging = true; state.dragStartX = e.clientX; state.dragStartY = e.clientY; state.dragCameraX = state.cameraX; state.dragCameraY = state.cameraY; }","function handleDragEnd(e) { if (state.isDragging) { const dx = e.clientX - state.dragStartX, dy = e.clientY - state.dragStartY; if (Math.abs(dx) >= 5 || Math.abs(dy) >= 5) { state.cameraX = state.dragCameraX - dx; state.cameraY = state.dragCameraY - dy; } } state.isDragging = false; }","function handleTouchStart(e) { if (e.touches.length === 1) { e.preventDefault(); const t = e.touches[0]; state.isDragging = true; state.dragStartX = t.clientX; state.dragStartY = t.clientY; state.dragCameraX = state.cameraX; state.dragCameraY = state.cameraY; } }","function handleTouchMove(e) { if (e.touches.length === 1 && state.isDragging) { e.preventDefault(); const t = e.touches[0]; state.cameraX = state.dragCameraX - (t.clientX - state.dragStartX); state.cameraY = state.dragCameraY - (t.clientY - state.dragStartY); } }","function handleTouchEnd() { state.isDragging = false; }","","function renderIsoMap() {","  ctx.clearRect(0, 0, canvas.width, canvas.height);","  const levelData = LEVELS[state.level]; const offsetX = canvas.width / 2, offsetY = canvas.height * 0.35;","  const tw = getTileW(), th = getTileH();","  const gradient = ctx.createRadialGradient(offsetX, offsetY, 50, offsetX, offsetY, 600);","  gradient.addColorStop(0, '#1a1a2e'); gradient.addColorStop(1, '#0a0a1a');","  ctx.fillStyle = gradient; ctx.fillRect(0, 0, canvas.width, canvas.height);","  for (let x = 0; x < 32; x++) { for (let y = 0; y < 26; y++) {","    const iso = toIso(x, y); const sx = iso.x + offsetX - state.cameraX, sy = iso.y + offsetY - state.cameraY;","    if (sx < -tw || sx > canvas.width + tw || sy < -th*2 || sy > canvas.height + th*2) continue;","    ctx.fillStyle = ((x + y) % 2 === 0) ? '#1e1e32' : '#1a1a2e'; ctx.beginPath();","    ctx.moveTo(sx, sy); ctx.lineTo(sx + tw*0.5, sy + th*0.5); ctx.lineTo(sx, sy + th); ctx.lineTo(sx - tw*0.5, sy + th*0.5);","    ctx.closePath(); ctx.fill(); ctx.strokeStyle = '#2a2a42'; ctx.lineWidth = 0.5; ctx.stroke();","  }}","  const buildings = [{x:2,y:2,h:40,w:15,c:'#3a3a5e'},{x:6,y:2,h:55,w:18,c:'#4a4a6e'},{x:20,y:2,h:45,w:16,c:'#3a3a5e'},{x:26,y:2,h:60,w:20,c:'#5a5a7e'},{x:2,y:8,h:50,w:17,c:'#4a4a6e'},{x:28,y:8,h:35,w:14,c:'#3a3a5e'},{x:4,y:15,h:45,w:16,c:'#4a4a6e'},{x:26,y:15,h:55,w:18,c:'#5a5a7e'},{x:2,y:20,h:40,w:15,c:'#3a3a5e'},{x:28,y:20,h:50,w:17,c:'#4a4a6e'},{x:12,y:2,h:35,w:14,c:'#3a3a5e'},{x:22,y:25,h:45,w:16,c:'#4a4a6e'},{x:8,y:22,h:40,w:15,c:'#3a3a5e'}];","  buildings.forEach(b => {","    const iso = toIso(b.x, b.y); const sx = iso.x + offsetX - state.cameraX, sy = iso.y + offsetY - state.cameraY;","    if (sx < -50 || sx > canvas.width + 50 || sy < -100 || sy > canvas.height + 50) return;","    const h = b.h * ZOOM, w = b.w * ZOOM; ctx.fillStyle = 'rgba(0,0,0,0.3)';","    ctx.beginPath(); ctx.moveTo(sx-w*0.3,sy+5); ctx.lineTo(sx+w*0.3,sy+5); ctx.lineTo(sx+w*0.5,sy+th*0.5+5); ctx.lineTo(sx-w*0.1,sy+th*0.5+5); ctx.closePath(); ctx.fill();","    ctx.fillStyle = b.c; ctx.beginPath(); ctx.moveTo(sx-w*0.5,sy-h); ctx.lineTo(sx,sy-h+th*0.5); ctx.lineTo(sx,sy+th*0.5); ctx.lineTo(sx-w*0.5,sy); ctx.closePath(); ctx.fill();","    ctx.fillStyle = lightenColor(b.c, 30); ctx.beginPath(); ctx.moveTo(sx,sy-h+th*0.5); ctx.lineTo(sx+w*0.5,sy-h); ctx.lineTo(sx+w*0.5,sy); ctx.lineTo(sx,sy+th*0.5); ctx.closePath(); ctx.fill();","    ctx.fillStyle = lightenColor(b.c, 50); ctx.beginPath(); ctx.moveTo(sx,sy-h); ctx.lineTo(sx+w*0.5,sy-h+th*0.5); ctx.lineTo(sx,sy-h+th); ctx.lineTo(sx-w*0.5,sy-h+th*0.5); ctx.closePath(); ctx.fill();","    ctx.fillStyle = 'rgba(255,255,150,0.4)'; const ws = 3*ZOOM;","    for (let wy = 0; wy < 3; wy++) for (let wx = 0; wx < 2; wx++) { const winY = sy - h + 10*ZOOM + wy*12*ZOOM; if (Math.sin(b.x*3+b.y*7+wx+wy) > 0) { ctx.fillRect(sx-w*0.3+wx*8*ZOOM, winY, ws, ws); ctx.fillRect(sx+w*0.1+wx*8*ZOOM, winY, ws, ws); }}","  });","  CONNECTIONS.forEach(([s1, s2, baseCost]) => {","    if (!STATIONS[s1] || !STATIONS[s2]) return;","    const st1 = STATIONS[s1], st2 = STATIONS[s2];","    const iso1 = toIso(st1.x, st1.y), iso2 = toIso(st2.x, st2.y);","    const sx1 = iso1.x + offsetX - state.cameraX, sy1 = iso1.y + offsetY - state.cameraY;","    const sx2 = iso2.x + offsetX - state.cameraX, sy2 = iso2.y + offsetY - state.cameraY;","    const blocked1 = state.blockedStations.has(s1), blocked2 = state.blockedStations.has(s2);","    const isTransfer = baseCost >= 10; const finalCost = getConnectionCost(s1, s2); const isSlow = finalCost > baseCost + 2;","    ctx.strokeStyle = 'rgba(0,0,0,0.3)'; ctx.lineWidth = (isTransfer ? 3 : 5) * ZOOM; ctx.globalAlpha = 0.5;","    ctx.beginPath(); ctx.moveTo(sx1, sy1+3); ctx.lineTo(sx2, sy2+3); ctx.stroke();","    ctx.strokeStyle = blocked1 || blocked2 ? '#9b59b6' : (isTransfer ? '#fff' : st1.color);","    ctx.lineWidth = (isTransfer ? 2 : 4) * ZOOM; ctx.globalAlpha = blocked1 || blocked2 ? 0.3 : (isTransfer ? 0.6 : 0.8);","    ctx.lineCap = 'round'; ctx.setLineDash(isTransfer ? [5*ZOOM, 5*ZOOM] : []);","    if (isSlow && !blocked1 && !blocked2) { ctx.strokeStyle = '#e74c3c'; ctx.globalAlpha = 0.8; }","    ctx.beginPath(); ctx.moveTo(sx1, sy1); ctx.lineTo(sx2, sy2); ctx.stroke();","    ctx.setLineDash([]); ctx.globalAlpha = 1; ctx.lineCap = 'butt';","  });","  Object.entries(STATIONS).forEach(([name, st]) => {","    const iso = toIso(st.x, st.y); const sx = iso.x + offsetX - state.cameraX, sy = iso.y + offsetY - state.cameraY;","    if (sx < -30 || sx > canvas.width + 30 || sy < -30 || sy > canvas.height + 30) return;","    const isCurrent = name === state.currentStation; const isGoal = name === levelData.goal;","    const isBlocked = state.blockedStations.has(name); const isAdjacent = isAdjacentToCurrent(name); const isHovered = name === state.hoveredStation;","    ctx.fillStyle = 'rgba(0,0,0,0.4)'; ctx.beginPath(); ctx.ellipse(sx+2, sy+8*ZOOM, 10*ZOOM, 5*ZOOM, 0, 0, Math.PI*2); ctx.fill();","    const baseColor = isBlocked ? '#9b59b6' : (st.shop ? '#3498db' : st.color);","    ctx.fillStyle = baseColor; ctx.globalAlpha = isBlocked ? 0.4 : 0.9;","    ctx.beginPath(); ctx.moveTo(sx, sy-3*ZOOM); ctx.lineTo(sx+12*ZOOM, sy+3*ZOOM); ctx.lineTo(sx, sy+9*ZOOM); ctx.lineTo(sx-12*ZOOM, sy+3*ZOOM); ctx.closePath(); ctx.fill(); ctx.globalAlpha = 1;","    const radius = isCurrent ? 10*ZOOM : (isHovered ? 9*ZOOM : 7*ZOOM);","    const circleColor = isCurrent ? '#fff' : (isGoal ? '#2ecc71' : (isBlocked ? '#9b59b6' : st.color));","    if (isAdjacent && !isBlocked) { ctx.strokeStyle = '#fff'; ctx.lineWidth = 2*ZOOM; ctx.globalAlpha = 0.5 + 0.5 * Math.sin(Date.now() * 0.008); ctx.beginPath(); ctx.arc(sx, sy, radius+4*ZOOM, 0, Math.PI*2); ctx.stroke(); ctx.globalAlpha = 1; }","    ctx.fillStyle = circleColor; ctx.strokeStyle = isCurrent ? '#ff6b35' : '#fff'; ctx.lineWidth = isCurrent ? 3*ZOOM : 2*ZOOM;","    ctx.beginPath(); ctx.arc(sx, sy, radius, 0, Math.PI*2); ctx.fill(); ctx.stroke();","    if (isCurrent) { ctx.strokeStyle = '#ff6b35'; ctx.lineWidth = 2*ZOOM; ctx.globalAlpha = 0.3 + 0.3 * Math.sin(Date.now() * 0.005); ctx.beginPath(); ctx.arc(sx, sy, radius+8*ZOOM, 0, Math.PI*2); ctx.stroke(); ctx.globalAlpha = 1; }","    const iconSize = Math.floor(12*ZOOM); ctx.font = \\`\\${iconSize}px serif\\`; ctx.textAlign = 'center';","    if (isGoal) ctx.fillText('', sx, sy-radius-8*ZOOM);","    if (st.shop && !isCurrent && !isGoal) ctx.fillText('🏪', sx+14*ZOOM, sy-8*ZOOM);","    if (isBlocked) ctx.fillText('', sx+14*ZOOM, sy-8*ZOOM);","    const fontSize = Math.max(7, Math.floor(9*ZOOM)); ctx.font = \\`\\${fontSize}px Roboto, sans-serif\\`; ctx.textAlign = 'center';","    ctx.fillStyle = isBlocked ? '#9b59b6' : '#fff'; ctx.strokeStyle = 'rgba(0,0,0,0.8)'; ctx.lineWidth = 3;","    ctx.strokeText(name, sx, sy+radius+12*ZOOM); ctx.fillText(name, sx, sy+radius+12*ZOOM);","    if (!isCurrent && !isGoal) { ctx.font = \\`\\${Math.floor(7*ZOOM)}px Roboto, sans-serif\\`; ctx.fillStyle = st.color; ctx.fillText(\\`L\\${st.line}\\`, sx, sy+radius+22*ZOOM); }","  });","  if (state.currentStation) {","    const st = STATIONS[state.currentStation]; const iso = toIso(st.x, st.y);","    const sx = iso.x + offsetX - state.cameraX, sy = iso.y + offsetY - state.cameraY;","    ctx.fillStyle = 'rgba(0,0,0,0.4)'; ctx.beginPath(); ctx.ellipse(sx, sy+10*ZOOM, 8*ZOOM, 4*ZOOM, 0, 0, Math.PI*2); ctx.fill();","    ctx.fillStyle = '#ff6b35'; ctx.fillRect(sx-6*ZOOM, sy-18*ZOOM, 12*ZOOM, 18*ZOOM);","    ctx.fillStyle = '#f39c12'; ctx.beginPath(); ctx.arc(sx, sy-22*ZOOM, 6*ZOOM, 0, Math.PI*2); ctx.fill();","    ctx.font = \\`bold \\${Math.floor(10*ZOOM)}px 'Press Start 2P', monospace\\`; ctx.textAlign = 'center'; ctx.fillStyle = '#ff6b35';","    ctx.strokeStyle = '#000'; ctx.lineWidth = 2; ctx.strokeText('TÚ', sx, sy-32*ZOOM); ctx.fillText('TÚ', sx, sy-32*ZOOM);","  }","}","","function lightenColor(color, percent) {","  const num = parseInt(color.replace('#',''), 16); const amt = Math.round(2.55*percent);","  const R = Math.min(255, (num>>16)+amt); const G = Math.min(255, ((num>>8)&0xFF)+amt); const B = Math.min(255, (num&0xFF)+amt);","  return '#' + (0x1000000 + R*0x10000 + G*0x100 + B).toString(16).slice(1);","}","","function handleCanvasClick(e) {","  if (state.isDragging) return;","  const rect = canvas.getBoundingClientRect(); const x = e.clientX - rect.left, y = e.clientY - rect.top;","  const offsetX = canvas.width/2, offsetY = canvas.height*0.35;","  let clickedStation = null, minDist = Infinity;","  Object.entries(STATIONS).forEach(([name, st]) => {","    const iso = toIso(st.x, st.y); const sx = iso.x + offsetX - state.cameraX, sy = iso.y + offsetY - state.cameraY;","    const dist = Math.sqrt((x-sx)**2 + (y-sy)**2); if (dist < 15*ZOOM && dist < minDist) { minDist = dist; clickedStation = name; }","  });","  if (clickedStation) {","    if (isAdjacentToCurrent(clickedStation) && !state.blockedStations.has(clickedStation)) selectStation(clickedStation);","    else if (state.blockedStations.has(clickedStation)) showFloatMsg('🚧 Estación bloqueada', '#9b59b6');","    else showFloatMsg('❌ No conectada', '#e74c3c');","  }","}","function handleCanvasMove(e) {","  const rect = canvas.getBoundingClientRect(); const x = e.clientX - rect.left, y = e.clientY - rect.top;","  const offsetX = canvas.width/2, offsetY = canvas.height*0.35; let found = null;","  Object.entries(STATIONS).forEach(([name, st]) => {","    const iso = toIso(st.x, st.y); const sx = iso.x + offsetX - state.cameraX, sy = iso.y + offsetY - state.cameraY;","    if (Math.sqrt((x-sx)**2 + (y-sy)**2) < 15*ZOOM) found = name;","  });","  state.hoveredStation = found;","  canvas.style.cursor = found ? (isAdjacentToCurrent(found) && !state.blockedStations.has(found) ? 'pointer' : 'not-allowed') : 'grab';","}","function isAdjacentToCurrent(stationName) {","  if (!state.currentStation) return false;","  return CONNECTIONS.some(([s1,s2]) => (s1===state.currentStation && s2===stationName) || (s2===state.currentStation && s1===stationName));","}","function getConnectionCost(s1, s2) {","  for (const [a, b, cost] of CONNECTIONS) {","    if ((a===s1 && b===s2) || (a===s2 && b===s1)) { const key = \\`\\${a}-\\${b}\\`; return state.timeModifiers[key] || cost; }","  } return 5;","}","","function startGame() { document.getElementById('start-screen').style.display = 'none'; document.getElementById('game-screen').style.display = 'flex'; document.getElementById('tutorial').style.display = 'flex'; }","function closeTutorial() { document.getElementById('tutorial').style.display = 'none'; loadLevel(0); startNewsGenerator(); }","function loadLevel(lvl) {","  state.level = lvl; const levelData = LEVELS[lvl]; state.currentStation = levelData.start;","  state.staminaMax = levelData.staminaMax; state.stamina = state.staminaMax; state.money = levelData.moneyStart;","  state.dayMinutes = DAY_START_MINUTES; state.steps = 0; state.robbed = 0; state.gameOver = false; state.paused = false;","  state.selectedStation = null; state.visitedStations = new Set([levelData.start]);","  state.blockedStations = new Set(levelData.blocked || []); state.newsLog = []; state.unreadNews = 0;","  state.monsterDiscount = false; state.dangerBoost = 0; state.timeModifiers = {}; state.dangerStations = new Set();","  ZOOM = 1.0; document.getElementById('zoom-level').textContent = '100%';","  const startSt = STATIONS[levelData.start]; const iso = toIso(startSt.x, startSt.y);","  state.cameraX = iso.x; state.cameraY = iso.y;","  document.getElementById('day-display').textContent = \\`DÍA \\${lvl+1} - \\${levelData.day}\\`;","  updateHUD(); clearNews(); generateInitialNews(); showStationInfo(levelData.start, levelData.startDesc, true);","  updateNewsBadge(); renderNewsFeed();","}","function formatTime(minutes) {","  const h = Math.floor(minutes / 60); const m = minutes % 60; const period = h >= 12 ? 'PM' : 'AM';","  const h12 = h > 12 ? h - 12 : (h === 0 ? 12 : h); return \\`\\${h12}:\\${m.toString().padStart(2,'0')} \\${period}\\`;","}","function selectStation(name) {","  if (state.paused || state.gameOver) return; state.selectedStation = name; const st = STATIONS[name]; const levelData = LEVELS[state.level];","  const timeCost = getConnectionCost(state.currentStation, name); const staminaCost = 8; const moneyCost = 5;","  let desc = '';","  if (name === levelData.goal) desc = levelData.goalDesc;","  else if (st.shop) { const monsterPrice = state.monsterDiscount ? 20 : 30; desc = \\`🏪 Hay una tienda. Monster: $\\${monsterPrice} (+40 stamina)\\`; }","  else desc = \\`Estación de la Línea \\${st.line}. ¿Viajar aquí?\\`;","  showStationPanel(name, desc, staminaCost, moneyCost, timeCost);","}","function showStationPanel(name, desc, staminaCost, moneyCost, timeCost) {","  const panel = document.getElementById('station-panel');","  document.getElementById('panel-title').textContent = \\`🚇 \\${name}\\`; document.getElementById('panel-desc').textContent = desc;","  const isTransfer = timeCost >= 10; const baseCost = isTransfer ? 12 : 5; const isSlow = timeCost > baseCost + 2;","  const timeClass = timeCost <= 6 ? 'low' : (timeCost <= 12 ? 'medium' : 'high');","  const timeLabel = isTransfer ? '🔄 Transferencia' : ' Estación'; const delayText = isSlow ? \\` (+\\${timeCost - baseCost} min retraso)\\` : '';","  const info = document.getElementById('panel-info');","  info.innerHTML = \\`<span class=\"time-cost \\${timeClass}\">⏱️ -\\${timeCost} min\\${delayText}</span><span>⚡ -\\${staminaCost}</span><span>💰 -$\\${moneyCost}</span><span>\\${timeLabel}</span>\\`;","  const btn = document.getElementById('btn-travel');","  const canAfford = state.stamina >= staminaCost && state.money >= moneyCost && (state.dayMinutes + timeCost) <= DAY_END_MINUTES;","  btn.textContent = canAfford ? ' VIAJAR' : '❌ SIN RECURSOS'; btn.style.opacity = canAfford ? '1' : '0.5'; btn.style.pointerEvents = canAfford ? 'all' : 'none';","  panel.style.display = 'block';","}","function showStationInfo(name, desc, isStart) {","  const panel = document.getElementById('station-panel');","  document.getElementById('panel-title').textContent = \\`📍 \\${name}\\`; document.getElementById('panel-desc').textContent = desc;","  document.getElementById('panel-info').innerHTML = isStart ? '<span>🏠 Punto de inicio</span>' : '';","  document.getElementById('btn-travel').style.display = 'none';","  document.querySelector('.btn-cancel').textContent = '✓ Entendido';","  document.querySelector('.btn-cancel').onclick = () => { closePanel(); document.getElementById('btn-travel').style.display = 'block'; document.querySelector('.btn-cancel').textContent = '❌ Cancelar'; document.querySelector('.btn-cancel').onclick = closePanel; };","  panel.style.display = 'block';","}","function closePanel() { document.getElementById('station-panel').style.display = 'none'; state.selectedStation = null; }","function confirmTravel() {","  if (!state.selectedStation || state.paused || state.gameOver) return;","  const name = state.selectedStation; const st = STATIONS[name]; const levelData = LEVELS[state.level];","  const timeCost = getConnectionCost(state.currentStation, name); const staminaCost = 8; const moneyCost = 5;","  if (state.stamina < staminaCost || state.money < moneyCost) { showFloatMsg('¡Sin recursos!', '#e74c3c'); return; }","  if (state.dayMinutes + timeCost > DAY_END_MINUTES) { showFloatMsg('¡Muy tarde! Anochece...', '#e74c3c'); return; }","  state.stamina -= staminaCost; state.money -= moneyCost; state.dayMinutes += timeCost; state.steps++;","  state.visitedStations.add(name); state.currentStation = name;","  const iso = toIso(st.x, st.y); state.cameraX = iso.x; state.cameraY = iso.y;","  closePanel(); updateHUD(); showFloatMsg(\\`🚇 \\${name} (-\\${timeCost} min)\\`, '#3498db');","  if (name === levelData.goal) { setTimeout(() => endGame(true, levelData.goalDesc), 500); return; }","  if (st.shop) {","    setTimeout(() => {","      const monsterPrice = state.monsterDiscount ? 20 : 30;","      showEvent(' TIENDA', \\`¿Comprar Monster Energy? ($\\${monsterPrice}, +40 stamina)\\\\nSaldo: $\\${state.money}\\\\nStamina: \\${Math.floor(state.stamina)}\\`, [","        {text:'🥤 Comprar', cls:'btn-safe', action:()=>{ if (state.money >= monsterPrice) { state.money -= monsterPrice; state.stamina = Math.min(state.staminaMax, state.stamina + 40); showFloatMsg('+40 ⚡', '#f39c12'); addNews({type:'info', title:'🥤 Monster comprada', desc:'Energía recargada', impact:'+40 stamina', severity:'success'}); } else { showFloatMsg('Sin dinero 💸', '#e74c3c'); } closeEvent(); updateHUD(); }},","        {text:'❌ No', cls:'btn-danger', action:()=>closeEvent()}","      ]);","    }, 300); return;","  }","  if (state.dangerStations.has(name)) { setTimeout(() => checkDangerEvent(name), 300); }","  else { if (state.stamina <= 0) { state.stamina = 0; updateHUD(); showEvent(' SIN STAMINA', 'Te quedaste sin energía.', [{text:'😢 Perder', cls:'btn-danger', action:()=>{closeEvent(); endGame(false, 'Te quedaste sin stamina.');}}]); return; } updateHUD(); }","}","function checkDangerEvent(stationName) {","  const robChance = 0.55 - state.luck + state.dangerBoost;","  if (Math.random() < robChance) {","    const stolen = Math.floor(20 + Math.random() * 40); state.money = Math.max(0, state.money - stolen); state.robbed++;","    showEvent('¡TE ASALTARON!', \\`En \\${stationName} te quitaron $\\${stolen}. \"Debiste haber leído las noticias...\"\\`, [{text:'😢 Seguir', cls:'btn-danger', action:()=>{ closeEvent(); addNews({type:'danger', title:' ¡ASALTO CONFIRMADO!', desc:\\`Te robaron $\\${stolen} en \\${stationName}. Las noticias tenían razón.\\`, impact:\\`-$\\${stolen}\\`, severity:'danger'}); updateHUD(); checkStamina(); }}]);","  } else { addNews({type:'info', title:'😅 Pasaste de suerte', desc:\\`Ibas por \\${stationName} (zona reportada) pero no pasó nada. ¡Esta vez!\\`, impact:'Sin incidentes', severity:'success'}); updateHUD(); checkStamina(); }","}","function checkStamina() { if (state.stamina <= 0) { state.stamina = 0; updateHUD(); showEvent('😵 SIN STAMINA', 'Te quedaste sin energía.', [{text:'😢 Perder', cls:'btn-danger', action:()=>{closeEvent(); endGame(false, 'Te quedaste sin stamina.');}}]); } }","function updateHUD() {","  const stPct = (state.stamina / state.staminaMax) * 100; document.getElementById('stamina-bar').style.width = stPct + '%'; document.getElementById('stamina-text').textContent = Math.floor(state.stamina);","  const dayProgress = ((state.dayMinutes - DAY_START_MINUTES) / TOTAL_DAY_MINUTES) * 100; document.getElementById('day-bar').style.width = dayProgress + '%'; document.getElementById('time-display').textContent = formatTime(state.dayMinutes);","  if (state.dayMinutes >= 19*60) document.getElementById('time-display').style.color = '#e74c3c';","  else if (state.dayMinutes >= 18*60) document.getElementById('time-display').style.color = '#f39c12';","  else document.getElementById('time-display').style.color = '#f39c12';","  document.getElementById('money-display').textContent = \\`$\\${state.money}\\`; document.getElementById('station-display').textContent = state.currentStation || 'Inicio';","}","function openApp(appName) {","  document.getElementById('phone-home').style.display = 'none'; document.querySelectorAll('.phone-app').forEach(a => a.classList.remove('active'));","  document.getElementById(\\`app-\\${appName}\\`).classList.add('active');","  if (appName === 'news') { state.unreadNews = 0; updateNewsBadge(); renderNewsFeed(); }","  else if (appName === 'saldo') renderSaldoFeed();","  else if (appName === 'map') renderMapFeed();","  else if (appName === 'config') { document.getElementById('cfg-level').textContent = state.level + 1; document.getElementById('cfg-steps').textContent = state.steps; document.getElementById('cfg-robbed').textContent = state.robbed; }","}","function goHome() { document.querySelectorAll('.phone-app').forEach(a => a.classList.remove('active')); document.getElementById('phone-home').style.display = 'flex'; }","function updateNewsBadge() { const badge = document.getElementById('news-badge'); if (state.unreadNews > 0) { badge.style.display = 'flex'; badge.textContent = state.unreadNews > 99 ? '99+' : state.unreadNews; } else { badge.style.display = 'none'; } }","","const NEWS_DATABASE = [","  { type: 'security', title: '🚨 ROBOS EN TEPITO', desc: 'Esta mañana en la estación Tepito se presenciaron demasiados robos.', impact: '⚠️ EVITA TEPITO - Alto riesgo de asalto', dangerStations: ['Tepito'], severity: 'danger' },","  { type: 'security', title: '🚨 ASALTOS EN LÍNEA 1', desc: 'Reportan asaltos frecuentes entre Candelaria y San Lázaro.', impact: '⚠️ Candelaria y San Lázaro peligrosas', dangerStations: ['Candelaria', 'San Lázaro', 'Candelaria LB', 'Candelaria LB2', 'San Lázaro LB', 'San Lázaro LB2'], severity: 'danger' },","  { type: 'security', title: ' ZONA CALIENTE EN MORELOS', desc: 'La estación Morelos reportó 3 asaltos en la última hora.', impact: '⚠️ Morelos es peligrosa ahora', dangerStations: ['Morelos'], severity: 'danger' },","  { type: 'security', title: '⚠️ PELIGRO EN LÍNEA B', desc: 'Usuarios reportan que Lagunilla y Garibaldi son zonas de alto riesgo.', impact: '⚠️ Lagunilla y Garibaldi peligrosas', dangerStations: ['Lagunilla', 'Garibaldi', 'Guerrero LB'], severity: 'danger' },","  { type: 'security', title: ' CUIDADO EN Isabel la Católica', desc: 'Un pasajero fue asaltado al salir de la estación.', impact: '⚠️ Isabel la Católica es riesgosa', dangerStations: ['Isabel la Católica'], severity: 'danger' },","  { type: 'security', title: ' MOCTEZUMA: ZONA DE CUIDADO', desc: 'Vecinos reportan presencia de personas sospechosas.', impact: '⚠️ Moctezuma con actividad delictiva', dangerStations: ['Moctezuma'], severity: 'danger' },","  { type: 'security', title: '🚨 ASALTOS EN LÍNEA 5', desc: 'La Línea 5 reporta robos en Valle Gómez y Consulado.', impact: '⚠️ Valle Gómez y Consulado peligrosas', dangerStations: ['Valle Gómez', 'Consulado', 'Eduardo Molina', 'Aragón'], severity: 'danger' },","  { type: 'security', title: '🚨 Tlatelolco: Robo a mano armada', desc: 'Esta madrugada asaltaron a un trabajador en Tlatelolco.', impact: '⚠️ Tlatelolco es peligrosa', dangerStations: ['Tlatelolco'], severity: 'danger' },","  { type: 'security', title: '🚨 ALERTA EN LÍNEA 3 NORTE', desc: 'Indios Verdes y La Raza reportan aumento de robos.', impact: '⚠️ Indios Verdes y La Raza con riesgo', dangerStations: ['Indios Verdes', 'La Raza', 'La Raza L5'], severity: 'danger' },","  { type: 'security', title: '⚠️ Pino Suárez: Zona de cuidado', desc: 'Varios reportes de carteristas en Pino Suárez.', impact: '⚠️ Pino Suárez con carteristas', dangerStations: ['Pino Suárez', 'Pino Suárez L2'], severity: 'danger' },","  { type: 'protest', title: ' PROTESTA EN INSURGENTES', desc: 'Manifestantes bloquean la estación Insurgentes.', impact: '🚧 Estación INSURGENTES BLOQUEADA', blockStations: ['Insurgentes'], severity: 'danger' },","  { type: 'protest', title: '📢 BLOQUEO EN LÍNEA 3', desc: 'Estudiantes bloquean Juárez. No hay servicio.', impact: '🚧 Estación JUÁREZ BLOQUEADA', blockStations: ['Juárez'], severity: 'danger' },","  { type: 'protest', title: '📢 MARCHA EN REFORMA', desc: 'Marcha masiva afecta Bellas Artes.', impact: '🚧 Estación BELLAS ARTES BLOQUEADA', blockStations: ['Bellas Artes'], severity: 'danger' },","  { type: 'protest', title: '📢 PARO EN LÍNEA B', desc: 'Trabajadores del Metro realizan paro en Garibaldi.', impact: '🚧 Estación GARIBALDI BLOQUEADA', blockStations: ['Garibaldi'], severity: 'danger' },","  { type: 'protest', title: ' MANIFESTACIÓN EN ZÓCALO', desc: 'Protesta en el centro histórico. Zócalo inaccesible.', impact: '🚧 Estación ZÓCALO BLOQUEADA', blockStations: ['Zócalo'], severity: 'danger' },","  { type: 'delay', title: '🚌 RUTA 87 RETRASADA', desc: 'La Ruta 87 tiene 20 min de retraso.', impact: '⏱️ +5 min en rutas de Línea 1', timeMod: {line: 1, extraCost: 5}, severity: 'warning' },","  { type: 'delay', title: '🚇 FALLA EN LÍNEA 2', desc: 'Falla eléctrica en la Línea 2. Servicio reducido.', impact: '⏱️ +8 min en rutas de Línea 2', timeMod: {line: 2, extraCost: 8}, severity: 'warning' },","  { type: 'delay', title: '⚠️ LÍNEA 5 CON DEMORA', desc: 'Demora de 15 minutos en Línea 5 por mantenimiento.', impact: '⏱️ +6 min en rutas de Línea 5', timeMod: {line: 5, extraCost: 6}, severity: 'warning' },","  { type: 'delay', title: '🚧 OBRAS EN LÍNEA B', desc: 'Obras en Tepito. Ruta lenta.', impact: '⏱️ +6 min en rutas de Línea B', timeMod: {line: 'B', extraCost: 6}, severity: 'warning' },","  { type: 'delay', title: '🚌 LA COMBI DEL \"RAYO\" NO PASÓ', desc: 'La combi del \"Rayo\" no pasó. Como siempre.', impact: '⏱️ +3 min en tu próximo viaje', timeMod: {line: 1, extraCost: 3}, severity: 'warning' },","  { type: 'weather', title: '🌧️ LLUVIA FUERTE', desc: 'Lluvia intensa en la ciudad. Caminos resbalosos.', impact: '⚡ -10 stamina', staminaPenalty: 10, severity: 'warning' },","  { type: 'weather', title: '☀️ CALOR EXTREMO 35°C', desc: 'Ola de calor. Hidrátate o perderás energía rápido.', impact: ' -15 stamina', staminaPenalty: 15, severity: 'warning' },","  { type: 'positive', title: '🎉 METRO EXPRESS', desc: 'Trenes express en Línea 3. Viaje más rápido.', impact: '️ -2 min en rutas de Línea 3', timeMod: {line: 3, extraCost: -2}, severity: 'success' },","  { type: 'positive', title: ' PROMOCIÓN MONSTER', desc: '2x1 en Monster Energy en todas las tiendas del Metro.', impact: '🥤 Monster cuesta $20 en lugar de $30', monsterDiscount: true, severity: 'success' },","  { type: 'positive', title: '🎉 METRO GRATIS HOY', desc: '¡El gobierno anunció metro gratis por el día!', impact: '💰 -$5 en tu próximo viaje (gratis)', moneyBonus: 5, severity: 'success' },","];","","function clearNews() { state.newsLog = []; document.getElementById('news-feed').innerHTML = ''; }","function generateInitialNews() {","  const levelData = LEVELS[state.level];","  addNews({ type: 'info', title: \\`📍 DÍA \\${state.level+1}: \\${levelData.day}\\`, desc: levelData.startDesc, impact: \\`🎯 Meta: \\${levelData.goal} | 🕐 Tienes hasta las 8:00 PM\\`, severity: 'info' });","  addNews({ type: 'info', title: '📱 TIP DEL DÍA', desc: 'Revisa las noticias ANTES de viajar. Te dirán dónde hay peligro, retrasos y bloqueos. ¡El mapa no te avisa!', impact: '📰 Abre la app de Noticias', severity: 'info' });","  setTimeout(() => { const securityNews = NEWS_DATABASE.filter(n => n.type === 'security'); const randomSecurity = securityNews[Math.floor(Math.random() * securityNews.length)]; triggerNews(randomSecurity); }, 2000);","}","function triggerNews(newsItem) {","  if (state.newsLog.some(n => n.title === newsItem.title)) return;","  addNews(newsItem); state.unreadNews++; updateNewsBadge(); showPushNotification(newsItem); applyNewsEffect(newsItem);","}","function addNews(newsItem) { const timeStr = formatTime(state.dayMinutes); state.newsLog.unshift({ ...newsItem, time: timeStr }); renderNewsFeed(); }","function renderNewsFeed() {","  const feed = document.getElementById('news-feed');","  if (state.newsLog.length === 0) { feed.innerHTML = '<div class=\"news-empty\"> Sin noticias aún</div>'; return; }","  feed.innerHTML = state.newsLog.map(n => \\`<div class=\"news-card \\${n.severity}\"><div class=\"news-card-header\"><span class=\"news-card-time\">\\${n.time}</span><span class=\"news-card-tag\">\\${n.type.toUpperCase()}</span></div><div class=\"news-card-title\">\\${n.title}</div><div class=\"news-card-desc\">\\${n.desc}</div>\\${n.impact ? \\`<div class=\"news-card-impact\">\\${n.impact}</div>\\` : ''}</div>\\`).join('');","}","function renderSaldoFeed() {","  const feed = document.getElementById('saldo-feed'); const levelData = LEVELS[state.level]; const timeLeft = DAY_END_MINUTES - state.dayMinutes;","  const timeLeftH = Math.floor(timeLeft / 60); const timeLeftM = timeLeft % 60;","  feed.innerHTML = \\`<div style=\"font-size: 10px; color: #888; margin-bottom: 10px;\">💳 Mi Billetera</div><div class=\"saldo-money\">$\\${state.money}</div><div class=\"saldo-stats\"><div class=\"saldo-stat\"><span class=\"saldo-stat-label\">⚡ Stamina</span><span class=\"saldo-stat-value\">\\${Math.floor(state.stamina)}/\\${state.staminaMax}</span></div><div class=\"saldo-stat\"><span class=\"saldo-stat-label\">🕐 Hora actual</span><span class=\"saldo-stat-value\">\\${formatTime(state.dayMinutes)}</span></div><div class=\"saldo-stat\"><span class=\"saldo-stat-label\">⏰ Tiempo restante</span><span class=\"saldo-stat-value\">\\${timeLeftH}h \\${timeLeftM}m</span></div><div class=\"saldo-stat\"><span class=\"saldo-stat-label\">🚇 Estaciones</span><span class=\"saldo-stat-value\">\\${state.steps}</span></div><div class=\"saldo-stat\"><span class=\"saldo-stat-label\">💀 Asaltos</span><span class=\"saldo-stat-value\">\\${state.robbed}</span></div><div class=\"saldo-stat\"><span class=\"saldo-stat-label\">📍 Actual</span><span class=\"saldo-stat-value\">\\${state.currentStation}</span></div><div class=\"saldo-stat\"><span class=\"saldo-stat-label\">🎯 Meta</span><span class=\"saldo-stat-value\">\\${levelData.goal}</span></div></div>\\`;","}","function renderMapFeed() {","  const feed = document.getElementById('map-feed'); const levelData = LEVELS[state.level]; const timeLeft = DAY_END_MINUTES - state.dayMinutes;","  const timeLeftH = Math.floor(timeLeft / 60); const timeLeftM = timeLeft % 60;","  feed.innerHTML = \\`<div style=\"font-size: 10px; color: #3498db; text-align: center; margin-bottom: 8px; font-weight: bold;\">️ RUTA DEL DÍA</div><div style=\"background: rgba(52,152,219,0.1); border: 1px solid #3498db; border-radius: 8px; padding: 8px; margin-bottom: 8px; font-size: 9px;\"><div style=\"display: flex; justify-content: space-between; margin-bottom: 4px;\"><span>🏠 Inicio:</span><span style=\"color: #f39c12; font-weight: bold;\">\\${levelData.start}</span></div><div style=\"display: flex; justify-content: space-between; margin-bottom: 4px;\"><span>🎯 Meta:</span><span style=\"color: #2ecc71; font-weight: bold;\">\\${levelData.goal}</span></div><div style=\"display: flex; justify-content: space-between;\"><span> Estoy en:</span><span style=\"color: #fff; font-weight: bold;\">\\${state.currentStation}</span></div></div><div style=\"font-size: 9px; color: #f39c12; margin-bottom: 8px; text-align: center;\">⏰ Hora: \\${formatTime(state.dayMinutes)} | Restante: \\${timeLeftH}h \\${timeLeftM}m</div><div style=\"font-size: 9px; color: #e74c3c; margin-bottom: 8px; text-align: center; font-weight: bold;\">⚠️ Zonas reportadas peligrosas:</div><div style=\"background: rgba(231,76,60,0.1); border: 1px solid #e74c3c; border-radius: 8px; padding: 8px; font-size: 9px;\">\\${state.dangerStations.size > 0 ? Array.from(state.dangerStations).map(s => \\`<div style=\"margin-bottom: 3px;\">🚨 \\${s}</div>\\`).join('') : '<div style=\"color: #2ecc71;\">✅ Sin reportes de peligro</div>'}</div><div style=\"font-size: 9px; color: #f39c12; margin-top: 8px; margin-bottom: 4px; text-align: center;\">🚧 Estaciones bloqueadas:</div><div style=\"background: rgba(155,89,182,0.1); border: 1px solid #9b59b6; border-radius: 8px; padding: 8px; font-size: 9px;\">\\${state.blockedStations.size > 0 ? Array.from(state.blockedStations).map(s => \\`<div style=\"margin-bottom: 3px;\">🚧 \\${s}</div>\\`).join('') : '<div style=\"color: #2ecc71;\">✅ Sin bloqueos</div>'}</div>\\`;","}","function applyNewsEffect(newsItem) {","  if (newsItem.blockStations) newsItem.blockStations.forEach(s => state.blockedStations.add(s));","  if (newsItem.dangerStations) newsItem.dangerStations.forEach(s => state.dangerStations.add(s));","  if (newsItem.timeMod) {","    CONNECTIONS.forEach(([s1, s2, baseCost]) => {","      const st1 = STATIONS[s1], st2 = STATIONS[s2];","      if (st1 && st2 && (st1.line === newsItem.timeMod.line || st2.line === newsItem.timeMod.line)) {","        const key = \\`\\${s1}-\\${s2}\\`; const currentMod = state.timeModifiers[key] || baseCost;","        state.timeModifiers[key] = Math.max(3, currentMod + newsItem.timeMod.extraCost);","      }","    });","  }","  if (newsItem.staminaPenalty) state.stamina = Math.max(0, state.stamina - newsItem.staminaPenalty);","  if (newsItem.monsterDiscount) state.monsterDiscount = true;","  if (newsItem.dangerBoost) state.dangerBoost += newsItem.dangerBoost;","}","function showPushNotification(newsItem) {","  const push = document.getElementById('push-notification');","  document.getElementById('push-title').textContent = newsItem.title; document.getElementById('push-text').textContent = newsItem.desc;","  push.style.display = 'block'; setTimeout(() => { push.style.display = 'none'; }, 4000);","}","function startNewsGenerator() {","  if (state.newsTimer) clearInterval(state.newsTimer);","  state.newsTimer = setInterval(() => {","    if (state.gameOver || state.paused) return;","    if (Math.random() < 0.5) { const available = NEWS_DATABASE.filter(n => !state.newsLog.some(l => l.title === n.title)); if (available.length > 0) triggerNews(available[Math.floor(Math.random() * available.length)]); }","  }, 10000 + Math.random() * 8000);","}","function showEvent(title, text, buttons) {","  state.paused = true; document.getElementById('event-title').textContent = title; document.getElementById('event-text').textContent = text;","  const btnContainer = document.getElementById('event-buttons'); btnContainer.innerHTML = '';","  buttons.forEach(b => { const btn = document.createElement('button'); btn.textContent = b.text; btn.className = b.cls; btn.onclick = b.action; btnContainer.appendChild(btn); });","  document.getElementById('event-popup').style.display = 'block';","}","function closeEvent() { state.paused = false; document.getElementById('event-popup').style.display = 'none'; }","function showFloatMsg(text, color) {","  const div = document.createElement('div'); div.className = 'float-msg'; div.textContent = text; div.style.color = color;","  document.getElementById('game-screen').appendChild(div); setTimeout(() => div.remove(), 1500);","}","function endGame(won, msg) {","  state.gameOver = true; if (state.newsTimer) clearInterval(state.newsTimer);","  const endScreen = document.getElementById('end-screen'); const title = document.getElementById('end-title'); const stats = document.getElementById('end-stats');","  if (won) { title.textContent = '🎉 ¡LLEGASTE!'; title.style.color = '#2ecc71'; } else { title.textContent = '💀 GAME OVER'; title.style.color = '#e74c3c'; }","  const timeUsed = state.dayMinutes - DAY_START_MINUTES; const timeUsedH = Math.floor(timeUsed / 60); const timeUsedM = timeUsed % 60;","  stats.innerHTML = \\`\\${msg}<br><br>⏰ Hora de llegada: \\${formatTime(state.dayMinutes)}<br>️ Tiempo de viaje: \\${timeUsedH}h \\${timeUsedM}m<br> Estaciones: \\${state.steps}<br> Dinero: $\\${state.money}<br> Asaltos: \\${state.robbed}<br>📰 Noticias leídas: \\${state.newsLog.length}<br>📅 Nivel: \\${state.level + 1} - \\${LEVELS[state.level].day}\\`;","  if (state.level >= 4 && won) { stats.innerHTML += '<br><br>🏆 ¡COMPLETASTE LA SEMANA! Eres un verdadero sobreviviente del transporte urbano.'; document.querySelector('#end-screen button').textContent = 'REINICIAR'; document.querySelector('#end-screen button').onclick = () => location.reload(); }","  else if (won) { document.querySelector('#end-screen button').textContent = 'SIGUIENTE DÍA →'; document.querySelector('#end-screen button').onclick = nextLevel; }","  else { document.querySelector('#end-screen button').textContent = 'REINTENTAR'; document.querySelector('#end-screen button').onclick = () => { endScreen.style.display = 'none'; loadLevel(state.level); startNewsGenerator(); }; }","  endScreen.style.display = 'flex';","}","function nextLevel() { document.getElementById('end-screen').style.display = 'none'; if (state.level < 4) { loadLevel(state.level + 1); startNewsGenerator(); } }","","if (document.readyState === 'loading') { document.addEventListener('DOMContentLoaded', init); } else { init(); }","`;","document.body.appendChild(script);"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false}],"layers":[{"ambientLightColorB":200,"ambientLightColorG":200,"ambientLightColorR":200,"camera2DPlaneMaxDrawingDistance":5000.0,"camera3DFarPlaneDistance":10000.0,"camera3DFieldOfView":45.0,"camera3DNearPlaneDistance":3.0,"cameraType":"","followBaseLayerCamera":false,"isLightingLayer":false,"isLocked":false,"name":"","renderingType":"","visibility":true,"cameras":[{"defaultSize":true,"defaultViewport":true,"height":0.0,"viewportBottom":1.0,"viewportLeft":0.0,"viewportRight":1.0,"viewportTop":0.0,"width":0.0}],"effects":[{"effectType":"Scene3D::HemisphereLight","name":"3D Ambient Hemisphere Light","doubleParameters":{"elevation":40.0,"intensity":0.33,"rotation":300.0},"stringParameters":{"groundColor":"127;127;127","skyColor":"255;255;255","top":"Z+"},"booleanParameters":{}},{"effectType":"Scene3D::DirectionalLight","name":"3D Sun Light","doubleParameters":{"distanceFromCamera":1500.0,"elevation":40.0,"frustumSize":4000.0,"intensity":0.75,"minimumShadowBias":0.0,"rotation":300.0,"shadowDistance":2000.0},"stringParameters":{"color":"255;255;255","shadowQuality":"medium","shadowRenderingMode":"fittedToCameraView","top":"Z+"},"booleanParameters":{"isCastingShadow":true}}]}],"behaviorsSharedData":[]}],"externalEvents":[],"eventsFunctionsExtensions":[],"externalLayouts":[]}