{"firstLayout":"","gdVersion":{"build":285,"major":5,"minor":6,"revision":0},"initialGDVersion":"5.6.285","properties":{"adaptGameResolutionAtRuntime":true,"antialiasingMode":"MSAA","antialisingEnabledOnMobile":false,"folderProject":false,"orientation":"landscape","packageName":"com.example.gamename","pixelsRounding":false,"projectUuid":"f04f9957-b98b-4904-b31c-82f2f58b9996","scaleMode":"linear","sizeOnStartupMode":"adaptWidth","templateSlug":"","version":"1.0.0","name":"UrbanMex","description":"","author":"","windowWidth":1280,"windowHeight":720,"latestCompilationDirectory":"","maxFPS":60,"minFPS":20,"verticalSync":false,"platformSpecificAssets":{},"loadingScreen":{"backgroundColor":0,"backgroundFadeInDuration":0.2,"backgroundImageResourceName":"","gdevelopLogoStyle":"light","logoAndProgressFadeInDuration":0.2,"logoAndProgressLogoFadeInDelay":0.0,"minDuration":1.5,"progressBarColor":16777215,"progressBarHeight":20.0,"progressBarMaxWidth":200.0,"progressBarMinWidth":40.0,"progressBarWidthPercent":30.0,"showGDevelopSplash":true,"showProgressBar":true},"watermark":{"placement":"bottom-left","showWatermark":true},"authorIds":[],"authorUsernames":[],"categories":[],"playableDevices":[],"extensionProperties":[],"platforms":[{"name":"GDevelop JS platform"}],"currentPlatform":"GDevelop JS platform"},"resources":{"resources":[]},"objects":[],"objectsFolderStructure":{"folderName":"__ROOT"},"objectsGroups":[],"variables":[],"layouts":[{"b":255,"disableInputWhenNotFocused":true,"mangledName":"Escena_32sin_32t_237tulo","name":"Escena sin título","r":247,"renderer3DWorldScale":100.0,"standardSortMethod":true,"stopSoundsOnStartup":true,"title":"","v":249,"uiSettings":{"grid":false,"gridType":"rectangular","gridWidth":32.0,"gridHeight":32.0,"gridDepth":32.0,"gridOffsetX":0.0,"gridOffsetY":0.0,"gridOffsetZ":0.0,"gridColor":10401023.0,"gridAlpha":0.8,"snap":false,"zoomFactor":0.546875,"windowMask":false,"selectedLayer":"","gameEditorMode":"instances-editor"},"objectsGroups":[],"variables":[],"instances":[],"objects":[],"objectsFolderStructure":{"folderName":"__ROOT"},"events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["// Código alternativo más robusto","setTimeout(() => {","  // Forzar que el contenedor esté por encima de todo","  const gameContainer = document.getElementById('game-container-wrapper');","  if (gameContainer) {","    gameContainer.style.cssText = 'position: fixed !important; top: 0 !important; left: 0 !important; width: 100vw !important; height: 100vh !important; z-index: 99999 !important; pointer-events: auto !important; overflow: hidden !important;';","  }","","  // Reemplazar onclick con addEventListener para todos los elementos interactivos","  const allInteractive = document.querySelectorAll('button, [onclick], .app-icon, .phone-app-back, #phone-homebtn, #iso-canvas');","  allInteractive.forEach(el => {","    const onclickAttr = el.getAttribute('onclick');","    if (onclickAttr) {","      el.style.pointerEvents = 'auto';","      el.style.cursor = 'pointer';","      el.addEventListener('click', (e) => {","        e.preventDefault();","        e.stopPropagation();","        try {","          const func = new Function(onclickAttr);","          func();","        } catch (err) {","          console.error('Error ejecutando:', onclickAttr, err);","        }","      });","      // Remover el atributo onclick para evitar conflictos","      el.removeAttribute('onclick');","    }","  });","","  console.log('✅ Sistema de clics completamente activado');","}, 300);"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":false},{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["// 1. Crear el contenedor del juego","const gameDiv = document.createElement('div');","gameDiv.id = 'game-container-wrapper';","gameDiv.style.cssText = 'position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 9999; overflow: hidden; pointer-events: auto;';","document.body.appendChild(gameDiv);","","// 2. Inyectar el HTML (Pega aquí el contenido de tu <div id=\"game-container\">...</div>)","gameDiv.innerHTML = `","  <div id=\"start-screen\">","    <div class=\"metro-icon\">🚇</div>","    <h1>SUPERVIVENCIA<br>URBANA</h1>","    <p class=\"subtitle\">\"Llegar a la meta... si el Metro lo permite\"</p>","    <button onclick=\"startGame()\">JUGAR</button>","  </div>","  <div id=\"tutorial\">","    <div class=\"tut-box\">","      <h3> CÓMO JUGAR</h3>","      <div class=\"tut-content\">","        <span>🎯 Objetivo:</span> Viaja por la CDMX desde tu casa hasta tu destino antes de que anochezca (8:00 PM).<br><br>","        <span>📱 CELULAR = TU ÚNICA GUÍA:</span> Las noticias te dirán dónde hay peligro, retrasos y bloqueos. ¡LÉELAS!<br><br>","        <span>⚠️ Peligro:</span> No hay señales en el mapa. Solo las noticias te avisan de zonas de robo. Si ignoras las noticias... te pueden asaltar.<br><br>","        <span>🕐 Tiempo:</span> El reloj avanza SOLO cuando viajas. Cada estación consume minutos reales del día.<br><br>","        <span>⏱️ Costos:</span> Estación normal: 5 min. Transferencia: 12 min. Retrasos por noticias: +minutos extra.<br><br>","        <span>⚡ Stamina:</span> Se gasta al viajar. Compra Monster en tiendas 🏪.<br><br>","        <span>💰 Dinero:</span> $5 por estación. ¡Cuidado con asaltos!<br><br>","        <span>🔍 Zoom:</span> Usa la rueda del mouse o los botones +/-.","      </div>","      <button onclick=\"closeTutorial()\">¡ENTENDIDO!</button>","    </div>","  </div>","  <div id=\"game-screen\">","    <div id=\"hud\">","      <div class=\"hud-left\">","        <div id=\"day-display\">DÍA 1</div>","        <div class=\"hud-item\">","          <span class=\"icon\">⚡</span>","          <div class=\"bar-container\"><div class=\"bar-fill stamina-fill\" id=\"stamina-bar\" style=\"width:100%\"></div></div>","          <span id=\"stamina-text\" style=\"font-size:9px\">100</span>","        </div>","        <div class=\"hud-item\"><span class=\"icon\"></span><span id=\"station-display\">Inicio</span></div>","      </div>","      <div class=\"hud-right\">","        <div class=\"hud-item\"><span class=\"icon\"></span><span id=\"money-display\">$150</span></div>","        <div class=\"hud-item\">","          <span class=\"icon\"></span>","          <div class=\"bar-container\"><div class=\"bar-fill day-fill\" id=\"day-bar\" style=\"width:0%\"></div></div>","          <span id=\"time-display\">7:00 AM</span>","        </div>","      </div>","    </div>","    <div id=\"map-area\">","      <canvas id=\"iso-canvas\"></canvas>","      <div id=\"zoom-controls\">","        <button onclick=\"changeZoom(0.2)\" title=\"Acercar\">+</button>","        <div id=\"zoom-level\">100%</div>","        <button onclick=\"changeZoom(-0.2)\" title=\"Alejar\">−</button>","      </div>","      <div id=\"phone\">","        <div id=\"phone-notch\"></div>","        <div id=\"phone-statusbar\"><span id=\"phone-time\">7:00</span><span>📶 🔋</span></div>","        <div id=\"phone-screen\">","          <div class=\"phone-home\" id=\"phone-home\">","            <div class=\"phone-home-header\">📱 Mi Celular</div>","            <div class=\"app-grid\">","              <div class=\"app-icon\" onclick=\"openApp('news')\"><div class=\"app-icon-img news-bg\">📰<div class=\"app-badge\" id=\"news-badge\" style=\"display:none\">0</div></div><div class=\"app-icon-label\">Noticias</div></div>","              <div class=\"app-icon\" onclick=\"openApp('map')\"><div class=\"app-icon-img map-bg\">🗺️</div><div class=\"app-icon-label\">Ruta</div></div>","              <div class=\"app-icon\" onclick=\"openApp('saldo')\"><div class=\"app-icon-img saldo-bg\">💰</div><div class=\"app-icon-label\">Saldo</div></div>","              <div class=\"app-icon\" onclick=\"openApp('config')\"><div class=\"app-icon-img config-bg\">⚙️</div><div class=\"app-icon-label\">Ajustes</div></div>","            </div>","          </div>","          <div class=\"phone-app\" id=\"app-news\"><div class=\"phone-app-header\"><div class=\"phone-app-back\" onclick=\"goHome()\">◀</div><div class=\"phone-app-title\"> Noticias del Día</div></div><div class=\"phone-app-body\" id=\"news-feed\"></div></div>","          <div class=\"phone-app\" id=\"app-map\"><div class=\"phone-app-header\" style=\"background: linear-gradient(135deg, #3498db, #2980b9);\"><div class=\"phone-app-back\" onclick=\"goHome()\">◀</div><div class=\"phone-app-title\">🗺️ Mi Ruta</div></div><div class=\"phone-app-body\" id=\"map-feed\"></div></div>","          <div class=\"phone-app\" id=\"app-saldo\"><div class=\"phone-app-header\" style=\"background: linear-gradient(135deg, #2ecc71, #27ae60);\"><div class=\"phone-app-back\" onclick=\"goHome()\">◀</div><div class=\"phone-app-title\">💰 Mi Saldo</div></div><div class=\"phone-app-body saldo-app\" id=\"saldo-feed\"></div></div>","          <div class=\"phone-app\" id=\"app-config\"><div class=\"phone-app-header\" style=\"background: linear-gradient(135deg, #95a5a6, #7f8c8d);\"><div class=\"phone-app-back\" onclick=\"goHome()\">◀</div><div class=\"phone-app-title\">⚙️ Ajustes</div></div><div class=\"phone-app-body\" style=\"padding: 15px; text-align: center; color: #888; font-size: 10px;\"><div style=\"margin-bottom: 15px;\"> Supervivencia Urbana v1.0</div><div style=\"margin-bottom: 10px;\"> Nivel: <span id=\"cfg-level\">1</span></div><div style=\"margin-bottom: 10px;\">🚇 Estaciones: <span id=\"cfg-steps\">0</span></div><div style=\"margin-bottom: 10px;\"> Asaltos: <span id=\"cfg-robbed\">0</span></div><button onclick=\"location.reload()\" style=\"font-family: 'Press Start 2P', monospace; font-size: 9px; padding: 8px 15px; background: #e74c3c; color: #fff; border: none; border-radius: 5px; cursor: pointer; margin-top: 10px;\">🔄 Reiniciar</button></div></div>","        </div>","        <div id=\"phone-bottombar\"><div id=\"phone-homebtn\" onclick=\"goHome()\"></div></div>","      </div>","      <div id=\"push-notification\">","        <div class=\"push-header\"><div class=\"push-app-icon\">📰</div><span>Noticias CDMX • ahora</span></div>","        <div class=\"push-title\" id=\"push-title\">Alerta</div>","        <div class=\"push-text\" id=\"push-text\">Texto</div>","      </div>","      <div id=\"station-panel\">","        <h3 id=\"panel-title\">Estación</h3>","        <p id=\"panel-desc\">Descripción</p>","        <div class=\"station-info\" id=\"panel-info\"></div>","        <button class=\"btn-confirm\" id=\"btn-travel\" onclick=\"confirmTravel()\">🚇 VIAJAR</button>","        <button class=\"btn-cancel\" onclick=\"closePanel()\">❌ Cancelar</button>","      </div>","      <div id=\"legend\">","        <h4>LEYENDA</h4>","        <div class=\"legend-item\"><div class=\"legend-color\" style=\"background:#fff\"></div> Tú</div>","        <div class=\"legend-item\"><div class=\"legend-color\" style=\"background:#2ecc71\"></div>🎯 Meta</div>","        <div class=\"legend-item\"><div class=\"legend-color\" style=\"background:#3498db\"></div>🏪 Tienda</div>","        <div class=\"legend-item\"><div class=\"legend-color\" style=\"background:#9b59b6\"></div>🚧 Bloqueada</div>","        <div class=\"legend-item\" style=\"color:#e74c3c\">️ Lee las noticias</div>","      </div>","    </div>","    <div id=\"event-popup\">","      <h3 id=\"event-title\">Evento</h3>","      <p id=\"event-text\">Texto</p>","      <div class=\"event-buttons\" id=\"event-buttons\"></div>","    </div>","  </div>","  <div id=\"end-screen\">","    <h2 id=\"end-title\">¡LLEGASTE!</h2>","    <div class=\"stats\" id=\"end-stats\"></div>","    <button onclick=\"nextLevel()\">CONTINUAR</button>","  </div>","`;","","// 3. Inyectar el CSS","const style = document.createElement('style');","style.innerHTML = `","@import url('https://fonts.cdnfonts.com/css/press-start-2p');","@import url('https://fonts.cdnfonts.com/css/roboto');","* { margin: 0; padding: 0; box-sizing: border-box; }","body { font-family: 'Roboto', sans-serif; background: #0a0a1a; color: #fff; overflow: hidden; height: 100vh; width: 100vw; user-select: none; -webkit-user-select: none; }","#game-container-wrapper { width: 100vw; height: 100vh; position: relative; overflow: hidden; }","#start-screen { position: absolute; inset: 0; background: linear-gradient(135deg, #0f0c29, #302b63, #24243e); display: flex; flex-direction: column; align-items: center; justify-content: center; z-index: 100; padding: 20px; }","#start-screen h1 { font-family: 'Press Start 2P', monospace; font-size: clamp(16px, 4vw, 28px); color: #ff6b35; text-shadow: 3px 3px 0 #c0392b; text-align: center; margin-bottom: 8px; line-height: 1.4; }","#start-screen .subtitle { font-size: clamp(10px, 2vw, 14px); color: #aaa; margin-bottom: 30px; text-align: center; font-style: italic; }","#start-screen .metro-icon { font-size: 70px; margin-bottom: 20px; }","#start-screen button { font-family: 'Press Start 2P', monospace; font-size: clamp(10px, 2vw, 14px); padding: 15px 40px; background: linear-gradient(180deg, #ff6b35, #c0392b); color: #fff; border: 3px solid #ff6b35; border-radius: 8px; cursor: pointer; }","#tutorial { position: absolute; inset: 0; background: rgba(0,0,0,0.95); display: none; flex-direction: column; align-items: center; justify-content: center; z-index: 90; padding: 20px; overflow-y: auto; }","#tutorial .tut-box { max-width: 450px; text-align: center; }","#tutorial h3 { font-family: 'Press Start 2P', monospace; font-size: clamp(12px, 2.5vw, 16px); color: #f39c12; margin-bottom: 20px; }","#tutorial .tut-content { font-size: clamp(11px, 2vw, 13px); color: #ccc; line-height: 1.8; margin-bottom: 20px; text-align: left; }","#tutorial .tut-content span { color: #ff6b35; font-weight: bold; }","#tutorial button { font-family: 'Press Start 2P', monospace; font-size: 10px; padding: 10px 25px; background: #f39c12; color: #000; border: none; border-radius: 6px; cursor: pointer; }","#game-screen { position: absolute; inset: 0; display: none; background: #0a0a1a; flex-direction: column; }","#hud { padding: 8px 12px; background: rgba(0,0,0,0.8); display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #ff6b35; z-index: 10; flex-wrap: wrap; gap: 8px; }",".hud-left, .hud-right { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }",".hud-item { display: flex; align-items: center; gap: 5px; font-size: 11px; background: rgba(255,255,255,0.05); padding: 4px 8px; border-radius: 15px; }",".hud-item .icon { font-size: 14px; }",".bar-container { width: 80px; height: 10px; background: rgba(255,255,255,0.15); border-radius: 5px; overflow: hidden; }",".bar-fill { height: 100%; border-radius: 5px; transition: width 0.3s; }",".stamina-fill { background: linear-gradient(90deg, #f39c12, #e74c3c); }",".day-fill { background: linear-gradient(90deg, #f39c12, #e67e22, #c0392b); }","#money-display { font-family: 'Press Start 2P', monospace; font-size: 10px; color: #2ecc71; }","#time-display { font-family: 'Press Start 2P', monospace; font-size: 10px; color: #f39c12; }","#day-display { font-family: 'Press Start 2P', monospace; font-size: 9px; color: #f39c12; }","#station-display { font-family: 'Press Start 2P', monospace; font-size: 9px; color: #fff; }","#map-area { flex: 1; position: relative; overflow: hidden; background: linear-gradient(180deg, #1a1a2e 0%, #0f0f1e 100%); }","#iso-canvas { width: 100%; height: 100%; display: block; cursor: grab; }","#iso-canvas:active { cursor: grabbing; }","#zoom-controls { position: absolute; bottom: 80px; left: 10px; display: flex; flex-direction: column; gap: 5px; z-index: 15; }","#zoom-controls button { width: 36px; height: 36px; background: rgba(0,0,0,0.7); border: 2px solid #ff6b35; border-radius: 8px; color: #fff; font-size: 18px; cursor: pointer; display: flex; align-items: center; justify-content: center; }","#zoom-controls button:hover { background: rgba(255,107,53,0.3); }","#zoom-level { text-align: center; font-size: 9px; color: #888; font-family: 'Press Start 2P', monospace; }","#phone { position: absolute; top: 10px; right: 10px; width: clamp(180px, 28vw, 240px); height: clamp(320px, 50vw, 420px); background: #000; border-radius: 24px; border: 3px solid #333; overflow: hidden; z-index: 20; box-shadow: 0 10px 40px rgba(0,0,0,0.8), inset 0 0 0 2px #111; display: flex; flex-direction: column; }","#phone-notch { height: 22px; background: #000; display: flex; align-items: center; justify-content: center; border-bottom: 1px solid #222; }","#phone-notch::before { content: ''; width: 50px; height: 10px; background: #111; border-radius: 10px; border: 1px solid #333; }","#phone-statusbar { height: 18px; background: #111; display: flex; justify-content: space-between; align-items: center; padding: 0 10px; font-size: 9px; color: #fff; font-weight: bold; }","#phone-screen { flex: 1; background: #0a0a1a; overflow: hidden; position: relative; }",".phone-home { position: absolute; inset: 0; display: flex; flex-direction: column; padding: 10px; }",".phone-home-header { text-align: center; font-size: 10px; color: #888; margin-bottom: 8px; font-weight: bold; }",".app-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; flex: 1; align-content: start; }",".app-icon { display: flex; flex-direction: column; align-items: center; cursor: pointer; padding: 5px; border-radius: 12px; transition: all 0.2s; }",".app-icon:hover, .app-icon:active { background: rgba(255,255,255,0.1); transform: scale(0.95); }",".app-icon-img { width: 44px; height: 44px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 22px; margin-bottom: 4px; position: relative; }",".app-icon-img.news-bg { background: linear-gradient(135deg, #e74c3c, #c0392b); }",".app-icon-img.map-bg { background: linear-gradient(135deg, #3498db, #2980b9); }",".app-icon-img.saldo-bg { background: linear-gradient(135deg, #2ecc71, #27ae60); }",".app-icon-img.config-bg { background: linear-gradient(135deg, #95a5a6, #7f8c8d); }",".app-badge { position: absolute; top: -4px; right: -4px; background: #e74c3c; color: #fff; font-size: 9px; font-weight: bold; min-width: 16px; height: 16px; border-radius: 8px; display: flex; align-items: center; justify-content: center; padding: 0 4px; border: 2px solid #000; }",".app-icon-label { font-size: 8px; color: #ccc; text-align: center; }",".phone-app { position: absolute; inset: 0; background: #0a0a1a; display: none; flex-direction: column; }",".phone-app.active { display: flex; }",".phone-app-header { background: linear-gradient(135deg, #e74c3c, #c0392b); padding: 8px 10px; display: flex; align-items: center; gap: 8px; border-bottom: 1px solid #333; }",".phone-app-back { font-size: 16px; cursor: pointer; color: #fff; padding: 2px 6px; }",".phone-app-title { font-size: 11px; font-weight: bold; color: #fff; flex: 1; }",".phone-app-body { flex: 1; overflow-y: auto; padding: 8px; }",".phone-app-body::-webkit-scrollbar { width: 3px; }",".phone-app-body::-webkit-scrollbar-thumb { background: #555; border-radius: 3px; }",".news-card { background: rgba(255,255,255,0.05); border-radius: 8px; padding: 8px; margin-bottom: 6px; border-left: 3px solid #e74c3c; animation: slideIn 0.4s; }","@keyframes slideIn { from { opacity: 0; transform: translateX(-20px); } to { opacity: 1; transform: translateX(0); } }",".news-card.info { border-left-color: #3498db; }",".news-card.warning { border-left-color: #f39c12; }",".news-card.danger { border-left-color: #e74c3c; background: rgba(231,76,60,0.1); }",".news-card.success { border-left-color: #2ecc71; }",".news-card-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px; }",".news-card-time { font-size: 7px; color: #888; }",".news-card-tag { font-size: 7px; padding: 1px 5px; border-radius: 8px; background: rgba(255,255,255,0.1); color: #aaa; }",".news-card-title { font-size: 10px; font-weight: bold; color: #fff; margin-bottom: 3px; line-height: 1.3; }",".news-card-desc { font-size: 8px; color: #aaa; line-height: 1.4; }",".news-card-impact { font-size: 7px; color: #f39c12; margin-top: 4px; font-style: italic; }",".saldo-app { padding: 15px; text-align: center; }",".saldo-money { font-size: 28px; color: #2ecc71; font-family: 'Press Start 2P', monospace; margin: 15px 0; }",".saldo-stats { display: flex; flex-direction: column; gap: 8px; margin-top: 15px; }",".saldo-stat { background: rgba(255,255,255,0.05); padding: 8px; border-radius: 8px; display: flex; justify-content: space-between; font-size: 10px; }",".saldo-stat-label { color: #888; }",".saldo-stat-value { color: #fff; font-weight: bold; }","#phone-bottombar { height: 40px; background: #111; border-top: 1px solid #222; display: flex; align-items: center; justify-content: center; }","#phone-homebtn { width: 30px; height: 30px; border-radius: 50%; border: 2px solid #444; background: transparent; cursor: pointer; }","#push-notification { position: absolute; top: 60px; right: 10px; width: clamp(180px, 28vw, 240px); background: rgba(30,30,40,0.95); border: 1px solid #444; border-radius: 12px; padding: 10px; z-index: 25; display: none; box-shadow: 0 5px 20px rgba(0,0,0,0.5); animation: pushIn 0.4s; backdrop-filter: blur(10px); }","@keyframes pushIn { from { opacity: 0; transform: translateY(-20px); } to { opacity: 1; transform: translateY(0); } }",".push-header { display: flex; align-items: center; gap: 6px; margin-bottom: 6px; font-size: 9px; color: #888; }",".push-app-icon { width: 16px; height: 16px; background: #e74c3c; border-radius: 4px; display: flex; align-items: center; justify-content: center; font-size: 10px; }",".push-title { font-size: 10px; font-weight: bold; color: #fff; margin-bottom: 3px; }",".push-text { font-size: 9px; color: #ccc; line-height: 1.3; }","#station-panel { position: absolute; bottom: 10px; left: 10px; right: 10px; max-width: 380px; background: rgba(0,0,0,0.92); border: 2px solid #ff6b35; border-radius: 10px; padding: 12px; z-index: 15; display: none; }","#station-panel h3 { font-family: 'Press Start 2P', monospace; font-size: 1